generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEARNER
}

enum CourseStatus {
  DRAFT
  GENERATING
  IN_REVIEW
  PUBLISHED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  avatarUrl      String?
  role           Role      @default(LEARNER)
  xp             Int       @default(0)
  level          Int       @default(1)
  streakCount    Int       @default(0)
  longestStreak  Int       @default(0)
  streakLastDate DateTime?
  createdAt      DateTime  @default(now())

  courses       Course[]
  progress      UserProgress[]
  quizAttempts  QuizAttempt[]
  badges        UserBadge[]
  chatMessages  ChatMessage[]
}

model Course {
  id                 String       @id @default(cuid())
  title              String
  description        String       @db.Text
  learningObjectives String[]
  status             CourseStatus @default(DRAFT)
  sourceFilePath     String?
  sourceText         String?      @db.Text
  generationProgress String?
  createdBy          String
  createdAt          DateTime     @default(now())
  publishedAt        DateTime?

  creator     User              @relation(fields: [createdBy], references: [id])
  modules     Module[]
  reviewLogs  CourseReviewLog[]
  chatMessages ChatMessage[]
}

model Module {
  id           String  @id @default(cuid())
  courseId      String
  title        String
  description  String  @db.Text
  order        Int
  passingScore Int     @default(70)

  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  questions    QuizQuestion[]
  quizAttempts QuizAttempt[]

  @@index([courseId])
}

model Lesson {
  id              String   @id @default(cuid())
  moduleId        String
  title           String
  svgContent      String?  @db.Text
  contentMarkdown String   @db.Text
  keyTakeaways    String[]
  order           Int

  module   Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress UserProgress[]

  @@index([moduleId])
}

model QuizQuestion {
  id            String       @id @default(cuid())
  moduleId      String
  type          QuestionType
  questionText  String       @db.Text
  options       String[]
  correctAnswer String
  explanation   String       @db.Text
  difficulty    Difficulty   @default(EASY)
  order         Int

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  moduleId       String
  score          Int
  totalQuestions Int
  answersJson    String   @db.Text
  completedAt    DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([moduleId])
}

model Badge {
  id            String @id @default(cuid())
  name          String @unique
  description   String
  icon          String
  criteriaType  String
  criteriaValue Int

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  userId      String
  courseId     String
  elementType String
  elementId   String
  role        String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, elementType, elementId])
}

model CourseReviewLog {
  id              String   @id @default(cuid())
  courseId         String
  roundNumber     Int
  studentFeedback String   @db.Text
  authorChanges   String   @db.Text
  createdAt       DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}
